pipeline {
    agent none

    environment {
        IMAGE_NAME     = "shopping-cart"
        IMAGE_TAG      = "${env.BUILD_NUMBER}"
        DOCKERFILE     = "Dockerfile1"             // <-- your repo's Dockerfile is named Dockerfile1
        DEPLOY_HOST    = "manage-node-2"           // <-- set actual IP or hostname of manage-node-2
        DEPLOY_USER    = "ubuntu"                  // <-- SSH user on manage-node-2
        DEPLOY_PATH    = "/home/ubuntu/shopping-cart"
        SSH_CRED_ID    = "manage-node-2-ssh"       // <-- Jenkins credentials ID (SSH private key)
    }

    stages {

        // ============================
        // CI — runs on jenkins-slave
        // ============================
        stage('Checkout') {
            agent { label 'jenkins-slave' }
            steps {
                git branch: 'main', url: 'https://github.com/your-org/shopping-cart.git'
                // replace with your actual repo URL
            }
        }

        stage('Update Dockerfile') {
            agent { label 'jenkins-slave' }
            steps {
                writeFile file: "${DOCKERFILE}", text: '''# pull official base image
FROM node:12.2.0-alpine AS build
# working directory of containerized app
WORKDIR /app
# copy package files first (better layer caching)
COPY package*.json /app/
# install dependencies (react-scripts is already a local devDependency)
RUN npm install --silent
# copy rest of the app
COPY . /app/
# build the app (uses local node_modules/.bin/react-scripts automatically)
RUN npm run build
# prepare nginx
FROM nginx:1.16.0-alpine
COPY --from=build /app/build /usr/share/nginx/html
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx/nginx.conf /etc/nginx/conf.d
# fire for nginx
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
'''
            }
        }

        stage('Build Docker Image') {
            agent { label 'jenkins-slave' }
            steps {
                sh """
                    docker build -f ${DOCKERFILE} -t ${IMAGE_NAME}:${IMAGE_TAG} .
                    docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
                """
            }
        }

        stage('Smoke Test Container') {
            agent { label 'jenkins-slave' }
            steps {
                sh """
                    docker rm -f shopping-cart-test || true
                    docker run -d --name shopping-cart-test -p 127.0.0.1:8090:80 ${IMAGE_NAME}:${IMAGE_TAG}
                    sleep 5
                    curl -f http://localhost:8090 || (docker logs shopping-cart-test && exit 1)
                    docker rm -f shopping-cart-test
                """
            }
        }

        stage('Save Image for Transfer') {
            agent { label 'jenkins-slave' }
            steps {
                sh """
                    docker save ${IMAGE_NAME}:${IMAGE_TAG} | gzip > ${IMAGE_NAME}-${IMAGE_TAG}.tar.gz
                """
                stash name: 'docker-image', includes: "${IMAGE_NAME}-${IMAGE_TAG}.tar.gz"
                stash name: 'compose-file', includes: 'docker-compose.yml'
            }
        }

        // ============================
        // CD — deploy to manage-node-2
        // ============================
        stage('Transfer Image to manage-node-2') {
            agent { label 'jenkins-slave' }
            steps {
                unstash 'docker-image'
                unstash 'compose-file'
                sshagent(credentials: ["${SSH_CRED_ID}"]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${DEPLOY_USER}@${DEPLOY_HOST} "mkdir -p ${DEPLOY_PATH}"
                        scp -o StrictHostKeyChecking=no ${IMAGE_NAME}-${IMAGE_TAG}.tar.gz ${DEPLOY_USER}@${DEPLOY_HOST}:${DEPLOY_PATH}/
                        scp -o StrictHostKeyChecking=no docker-compose.yml ${DEPLOY_USER}@${DEPLOY_HOST}:${DEPLOY_PATH}/
                    """
                }
            }
        }

        stage('Deploy on manage-node-2') {
            agent { label 'jenkins-slave' }
            steps {
                sshagent(credentials: ["${SSH_CRED_ID}"]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${DEPLOY_USER}@${DEPLOY_HOST} '
                            cd ${DEPLOY_PATH} &&
                            gunzip -c ${IMAGE_NAME}-${IMAGE_TAG}.tar.gz | docker load &&
                            docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest &&
                            docker stop shopping-cart 2>/dev/null || true &&
                            docker rm shopping-cart 2>/dev/null || true &&
                            docker compose up -d --build &&
                            docker ps
                        '
                    """
                }
            }
        }

        stage('Verify Deployment') {
            agent { label 'jenkins-slave' }
            steps {
                sshagent(credentials: ["${SSH_CRED_ID}"]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${DEPLOY_USER}@${DEPLOY_HOST} 'curl -I http://localhost'
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Deployment to manage-node-2 succeeded: build ${IMAGE_TAG}"
        }
        failure {
            echo "Pipeline failed — check stage logs above."
        }
        always {
            node('jenkins-slave') {
                sh "rm -f ${IMAGE_NAME}-${IMAGE_TAG}.tar.gz || true"
            }
        }
    }
}
